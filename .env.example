# ==============================================================================
# FINANCE AI SERVER - MẪU BIẾN MÔI TRƯỜNG (.env.example)
# Hướng dẫn: Sao chép file này thành .env và điền các giá trị cấu hình của bạn:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CƠ SỞ DỮ LIỆU POSTGRESQL
# ------------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/finance
DB_NAME=finance
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# ------------------------------------------------------------------------------
# 2. REDIS CACHE (Lưu mã OTP xác thực email, rate limit...)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. BẢO MẬT & XÁC THỰC JWT
# Khóa bí mật HMAC-SHA256 dạng Base64 (tối thiểu 32 bytes / 256 bits).
# Lệnh sinh khóa nhanh trên Linux/macOS: openssl rand -base64 32
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_base64_jwt_key_min_32_bytes=

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH GỬI EMAIL (Gmail SMTP)
# Dùng để gửi mã OTP kích hoạt tài khoản và mã đặt lại mật khẩu.
# Lưu ý: MAIL_PASSWORD phải là "Mật khẩu ứng dụng" (App Password 16 chữ số)
# được sinh từ Google Account -> Bảo mật -> Xác minh 2 bước -> Mật khẩu ứng dụng.
# ------------------------------------------------------------------------------
MAIL_USERNAME=your_gmail_account@gmail.com
MAIL_PASSWORD=your_16_digit_gmail_app_password
MAIL_FROM=your_gmail_account@gmail.com

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH 2.0 (Đăng nhập với Google)
# Tạo dự án trên Google Cloud Console (APIs & Services -> Credentials -> OAuth 2.0 Client IDs).
#
# GOOGLE_WEB_CLIENT_ID: Bắt buộc để Backend kiểm tra chữ ký và trường `aud` của id_token.
# Phía Web/Mobile khi xin id_token đều phải gửi theo Web Client ID này.
# ------------------------------------------------------------------------------
GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=your_google_web_client_secret

# Client ID dành riêng cho App Android (liên kết với Keystore SHA-1 trên Google Console).
# Backend không đọc biến này; lưu lại để ghi nhận cấu hình dự án.
GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
