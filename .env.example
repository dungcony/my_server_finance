DB_URL=jdbc:postgresql://localhost:5432/finance_app
DB_USERNAME=postgres
DB_PASSWORD=changeme
JWT_SECRET=
POSTGRES_DB=finance_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Gửi mã đặt lại mật khẩu qua Gmail (bước M1-M3).
# MAIL_USERNAME là địa chỉ Gmail ĐÃ sinh ra app password — app password chỉ hợp
# lệ với đúng tài khoản đó, điền lệch một chữ là SMTP từ chối với
# `535 5.7.8 BadCredentials`. ĐÂY KHÔNG PHẢI hòm thư nhận mã: người nhận là
# email người dùng nhập ở màn Quên mật khẩu, không nằm trong file này.
#
# App password mất hiệu lực âm thầm (không có thông báo nào) khi tắt/bật lại
# Xác minh 2 bước, đổi mật khẩu tài khoản Google, hoặc thu hồi thủ công. Gặp
# `535` thì tách lỗi bằng smtplib của Python ngoài Spring: đăng nhập được
# nghĩa là lỗi ở cấu hình Spring, vẫn `535` nghĩa là phải sinh app password mới.
# Lấy app password: tài khoản Google > Bảo mật > Xác minh 2 bước > Mật khẩu ứng dụng.
#
# Google trả app password dạng bốn cụm cách nhau khoảng trắng. PHẢI đặt trong
# nháy đơn: file này được nạp bằng `set -a && . ./.env`, không nháy thì shell coi
# phần sau khoảng trắng là một lệnh và chết với "command not found".
MAIL_USERNAME=
MAIL_PASSWORD='xxxx xxxx xxxx xxxx'

# Tuỳ chọn: địa chỉ hiện ở trường From. Bỏ trống thì dùng chính MAIL_USERNAME.
# Gmail luôn ghi đè From bằng tài khoản đã xác thực, nên đặt khác cũng không có tác dụng.
MAIL_FROM=

# Đăng nhập bằng Google (nhóm D). Hai client sinh từ cùng một dự án Google
# Cloud Console nhưng dùng vào hai việc khác nhau — đừng hoán đổi.
#
# GOOGLE_WEB_CLIENT_ID: loại "Web application". Backend so trường `aud` của
# id_token với chuỗi này. Google đặt `aud` = web client id KỂ CẢ khi người
# dùng bấm nút trên Android, nên điền nhầm client Android vào đây thì mọi
# lần đăng nhập đều trượt mà thông báo lỗi không nói rõ vì sao.
GOOGLE_WEB_CLIENT_ID=

# GOOGLE_ANDROID_CLIENT_ID: loại "Android", khai kèm package name
# vn.ptit.datn.finance_ai và SHA-1 của keystore. Backend KHÔNG đọc biến này —
# google_sign_in trên máy tự khớp. Ghi lại cho biết đã tạo cái nào.
GOOGLE_ANDROID_CLIENT_ID=

# Không dùng tới ở luồng hiện tại (chỉ kiểm chữ ký id_token, không đổi
# authorization code lấy token). Giữ chỗ phòng khi thêm đăng nhập web.
GOOGLE_WEB_CLIENT_SECRET=
